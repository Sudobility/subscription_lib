{
  "name": "@sudobility/subscription_lib",
  "version": "0.0.55",
  "description": "Cross-platform subscription management with RevenueCat adapter pattern",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "typecheck": "bunx tsc --noEmit",
    "lint": "bunx eslint src",
    "lint:fix": "bunx eslint src --fix",
    "format": "bunx prettier --write \"src/**/*.{ts,tsx,js,jsx,json}\"",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "verify": "bun run typecheck && bun run lint && bun run test:unit && bun run build",
    "prepublishOnly": "bun run verify"
  },
  "peerDependencies": {
    "@revenuecat/purchases-js": "^1.0.0",
    "@sudobility/types": "^1.9.75",
    "@tanstack/react-query": "^5.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-native-purchases": ">=7.0.0"
  },
  "peerDependenciesMeta": {
    "@tanstack/react-query": {
      "optional": true
    },
    "@revenuecat/purchases-js": {
      "optional": true
    },
    "react-native-purchases": {
      "optional": true
    }
  },
  "devDependencies": {
    "@eslint/js": "~9.39.5",
    "@revenuecat/purchases-js": "~1.73.1",
    "@sudobility/types": "^1.9.75",
    "@tanstack/react-query": "~5.104.5",
    "@types/bun": "~1.4.4",
    "@types/node": "~22.20.5",
    "@types/react": "~19.3.0",
    "@typescript-eslint/eslint-plugin": "~8.72.0",
    "@typescript-eslint/parser": "~8.72.0",
    "eslint": "~9.39.5",
    "eslint-config-prettier": "~10.1.8",
    "eslint-plugin-prettier": "~5.5.7",
    "prettier": "~3.9.10",
    "typescript": "~5.9.3",
    "vitest": "~4.1.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/Sudobility/subscription_lib.git"
  },
  "license": "BUSL-1.1"
}
